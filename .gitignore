# ============================================
# CareerSync — Root .gitignore
# ============================================

# ──────────────────────────────────────────
# FRONTEND (Node / Vite / React)
# ──────────────────────────────────────────
node_modules/
dist/
build/
.cache/
.parcel-cache/
.vite/
*.local

# Env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────
# BACKEND (Python / Django)
# ──────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
venv/
env/
.venv/
.env/
ENV/

# Django
*.sqlite3
db.sqlite3
*.log
local_settings.py
/backend/staticfiles/
/backend/mediafiles/
/backend/media/
/backend/static/

# Migrations (optional - comment out if you want to track migrations)
# */migrations/*.py
# !*/migrations/__init__.py

# ──────────────────────────────────────────
# OS & EDITOR
# ──────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# VSCode
.vscode/
*.code-workspace

# JetBrains
.idea/
*.iml

# ──────────────────────────────────────────
# MISC
# ──────────────────────────────────────────
scratch/
list_opencode_models.py
*.zip
*.tar.gz
coverage/
.nyc_output/
