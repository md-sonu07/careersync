# Django
SECRET_KEY=replace-with-a-unique-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI chat routing. React calls Django only; do not put these values in frontend/.env.
AI_CHAT_PRIMARY_PROVIDER=ollama
AI_CHAT_FALLBACK_ENABLED=True
AI_CHAT_FALLBACK_PROVIDER=gemini

# Ollama (primary)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=30

# Gemini (fallback)
GEMINI_API_KEY=replace-with-your-server-side-gemini-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30
